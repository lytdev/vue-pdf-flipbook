{
  "name": "@agilehub/vue-pdf-flipbook",
  "version": "1.0.0",
  "description": "A minimal Vue 3 PDF flipbook with page-flip animation and public APIs for external controls.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": {
    "name": "agilehub"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/vue-pdf-flipbook.js",
  "module": "./dist/vue-pdf-flipbook.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-pdf-flipbook.js",
      "default": "./dist/vue-pdf-flipbook.js"
    },
    "./style.css": "./dist/vue-pdf-flipbook.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --import ./tests/register-ts.mjs --test tests/*.test.ts",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build": "npm run typecheck && vite build && npm run build:types",
    "preview": "vite preview",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run --cache .npm-cache",
    "test:package": "npm run build && node tests/package-imports.mjs"
  },
  "keywords": [
    "vue",
    "vue3",
    "pdf",
    "pdfjs",
    "flipbook",
    "reader"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "page-flip": "^2.0.7",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vue": "^3.5.40",
    "vue-tsc": "^3.2.2"
  }
}
